<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  LaterMD.app 的 bundle 描述。由 .github/workflows/macos-dmg.yml 在组装 .app 时
  用 sed 把 __VERSION__ 替换为实际版本号后拷入 Contents/。

  放在仓库文件里而不是 heredoc 写进 workflow:YAML block scalar 中的 heredoc
  结束标记必然带缩进,shell 认不出来,会静默吃掉整段脚本。

  LSMinimumSystemVersion 14.0 —— 平台基线 macOS 14 Sonoma
  (AGENTS.md §5:显式不支持 macOS 13 及以下)。
-->
<plist version="1.0">
<dict>
  <key>CFBundleName</key>
  <string>LaterMD</string>
  <key>CFBundleDisplayName</key>
  <string>LaterMD</string>
  <key>CFBundleIdentifier</key>
  <string>cn.ailater.LaterMD</string>
  <key>CFBundleExecutable</key>
  <string>latermd</string>
  <key>CFBundleVersion</key>
  <string>__VERSION__</string>
  <key>CFBundleShortVersionString</key>
  <string>__VERSION__</string>
  <key>CFBundlePackageType</key>
  <string>APPL</string>
  <key>CFBundleInfoDictionaryVersion</key>
  <string>6.0</string>
  <key>LSMinimumSystemVersion</key>
  <string>14.0</string>
  <key>NSHighResolutionCapable</key>
  <true/>
</dict>
</plist>
